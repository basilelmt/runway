{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "@testing-library/jest-dom"
    ],
    "paths": {
      "@shared/*": [
        "../shared/*"
      ],
      "@core/*": [
        "../core/*"
      ],
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts",
    "../shared"
  ]
}
